# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Local PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/lifeops

# ─────────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here

# The URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# AI PROVIDERS (add the one you're using)
# ─────────────────────────────────────────────

# Google Gemini — free tier available at https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI — free trial credits at https://platform.openai.com/
OPENAI_API_KEY=

# Which provider to use: "gemini" | "openai"
AI_PROVIDER=gemini

# ─────────────────────────────────────────────
# FILE STORAGE (local for now)
# ─────────────────────────────────────────────
# Relative path from project root where uploaded files are stored
UPLOAD_DIR=./uploads

# Max file size in MB
MAX_FILE_SIZE_MB=20
