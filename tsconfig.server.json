{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "server/**/*",
    "src/ai/**/*",
    "src/db/**/*",
    "src/modules/**/*",
    "src/lib/**/*",
    "src/types/**/*"
  ],
  "exclude": ["node_modules", "client", "src/app"]
}
